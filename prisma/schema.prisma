generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider     = "sqlite"
  url          = env("DATABASE_URL")
  // Para deploy com Turso, troque provider por "sqlite" com adapter libsql
  // O adapter é injetado em runtime via prisma/prisma.ts
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  age   Int?
  name  String?
  posts Post[]

  @@map("users")
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  author    User    @relation(fields: [author_id], references: [id])
  author_id Int     @map("author_id")

  @@map("posts")
}

model Task {
  id                        String   @id @default(uuid())
  title                     String
  description               String
  steps                     String?  // Armazena JSON em string
  estimated_time            String
  implementation_suggestion String?
  acceptance_criteria       String?  // Armazena JSON em string
  suggested_tests           String?  // Armazena JSON em string
  content                   String?  // Markdown combinado
  chat_history              String?  // Armazena JSON em string
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  @@map("tasks")
}