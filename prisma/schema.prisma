generator client {
  provider        = "prisma-client-js"
  output          = "../app/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id                        String   @id @default(uuid())
  title                     String
  description               String
  steps                     String?  // Armazena JSON em string
  estimated_time            String
  implementation_suggestion String?
  acceptance_criteria       String?  // Armazena JSON em string
  suggested_tests           String?  // Armazena JSON em string
  content                   String?  // Markdown combinado
  chat_history              String?  // Armazena JSON em string
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  @@map("tasks")
}